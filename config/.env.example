# Database Configuration (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=melbourne_property_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/melbourne_property_db

# Alerting & Webhook Configuration
ALERT_WEBHOOK_URL=
ALERT_MAX_BUDGET=950000
ALERT_MIN_DISCOUNT_PCT=5.0

# Optional Mapbox Token (falls back to open Carto tiles if unset)
MAPBOX_ACCESS_TOKEN=

# Real-World Data Connectors (Domain Developer API & Local CSV Paths)
# Get a Domain API key at: https://developer.domain.com.au/
DOMAIN_API_KEY=
VGVR_SETTLED_SALES_CSV=data/vgvr_settled_sales.csv
ACTIVE_LISTINGS_CSV=data/active_listings.csv

